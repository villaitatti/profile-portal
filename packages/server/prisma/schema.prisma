generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Application {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  url             String
  imageUrl        String?  @map("image_url")
  blurPlaceholder String?  @map("blur_placeholder")
  loginMethod     String   @default("vit-id") @map("login_method")
  requiredRoles   String[] @map("required_roles")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("applications")
}

// Closed set enforced by the database (migration 20260831_status_enums).
// Identifier-safe lowercase values so the runtime strings — and the API
// contract the web client sees — are byte-identical to the old String column.
enum SyncRunStatus {
  dry_run
  executing
  completed
  failed
  partial

  @@map("sync_run_status")
}

model SyncRun {
  id          String        @id @default(uuid())
  status      SyncRunStatus
  triggeredBy String    @map("triggered_by")
  dryRunId    String?   @map("dry_run_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  diff        Json      // full diff payload
  result      Json?     // per-operation execution log
  stats       Json?     // summary stats

  dryRun     SyncRun?  @relation("DryRunExecution", fields: [dryRunId], references: [id])
  executions SyncRun[] @relation("DryRunExecution")

  @@index([status, startedAt(sort: Desc)])
  @@map("sync_runs")
}

model VitIdClaim {
  id                   String   @id @default(uuid())
  email                String
  firstName            String   @map("first_name")
  lastName             String   @map("last_name")
  civicrmId            Int      @map("civicrm_id")
  hasFellowship        Boolean  @map("has_fellowship")
  hasCurrentFellowship Boolean  @map("has_current_fellowship")
  rolesAssigned        String[] @map("roles_assigned")
  orgsAssigned         String[] @map("orgs_assigned")
  claimedAt            DateTime @default(now()) @map("claimed_at")

  @@index([email])
  @@index([claimedAt(sort: Desc)])
  @@map("vit_id_claims")
}

enum AutomationRunStatus {
  dry_run
  executing
  completed
  failed
  partial
  // A dry_run row flips to consumed atomically when execution starts
  // (migration 20260903090000). Exactly one caller can win that flip, so a
  // double-click or replayed execute POST cannot run the same July automation
  // twice against Auth0/JSM. The execution itself is recorded as a separate
  // `executing` row, mirroring the SyncRun dry-run/execution split. Listed
  // last to match ALTER TYPE ... ADD VALUE, which appends.
  consumed

  @@map("automation_run_status")
}

model AutomationRun {
  id           String    @id @default(uuid())
  // Hyphenated values can't be Prisma enum identifiers without remapping the
  // runtime strings (an API contract change), so the closed set
  // end-of-year-cleanup | new-cohort-onboarding | backfill is enforced by a
  // database CHECK constraint instead (migration 20260831_status_enums).
  type         String
  status       AutomationRunStatus
  triggeredBy  String    @map("triggered_by") // cron | admin:{email}
  academicYear String    @map("academic_year")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  result       Json      // { processed, pending, errors, details: [...] }
  stats        Json?     // { removed, added, pending, errors }

  @@index([type, startedAt(sort: Desc)])
  @@map("automation_runs")
}

model RoleGroupMapping {
  id                 String   @id @default(uuid())
  auth0RoleId        String   @map("auth0_role_id")
  auth0RoleName      String   @map("auth0_role_name")
  atlassianGroupId   String?  @map("atlassian_group_id")
  atlassianGroupName String   @map("atlassian_group_name")
  createdBy          String?  @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([auth0RoleId, atlassianGroupId])
  @@index([auth0RoleId])
  @@map("role_group_mappings")
}

enum AppointeeEmailType {
  BIO_PROJECT_DESCRIPTION
  VIT_ID_INVITATION

  @@map("appointee_email_type")
}

enum AppointeeEmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED

  @@map("appointee_email_status")
}

// Tracks each delivery attempt for per-fellowship, per-type transactional
// emails to appointees (bio & project description request, VIT ID invitation).
// Multiple rows may exist for the same (fellowshipId, emailType) so resend
// history is preserved for the future email log page.
//
// Dashboard state reads the latest row per (fellowshipId, emailType). A raw
// partial unique index in migration 20260424170000 prevents duplicate
// in-flight rows (PENDING/SENDING) while allowing historical SENT/FAILED/
// SKIPPED rows to accumulate.
model AppointeeEmailEvent {
  id            String               @id @default(cuid())
  fellowshipId  Int                  @map("fellowship_id")
  contactId     Int                  @map("contact_id")
  academicYear  String               @map("academic_year")
  emailType     AppointeeEmailType   @map("email_type")
  status        AppointeeEmailStatus @default(PENDING)
  enqueuedAt    DateTime             @default(now()) @map("enqueued_at")
  sendAfter     DateTime             @map("send_after")
  sentAt        DateTime?            @map("sent_at")
  failureReason String?              @map("failure_reason")
  triggeredBy   String               @map("triggered_by") // "claim_auto" | "admin_manual:<userId>"
  sesMessageId  String?              @map("ses_message_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([fellowshipId, emailType, createdAt(sort: Desc)])
  @@index([status, sendAfter])
  @@index([contactId, academicYear]) // audit scans
  @@map("appointee_email_events")
}

enum FormInvitationStatus {
  pending
  submitted
  expired

  @@map("form_invitation_status")
}

model FormInvitation {
  id               String    @id @default(cuid())
  // sha256 hex of the bearer token (lib/hash-token.ts). The raw token is never
  // stored — it exists only in the generated link/email — so a leaked backup
  // cannot be replayed against the public form endpoints.
  tokenHash        String    @unique @map("token_hash")
  fellowshipId     Int       @map("fellowship_id")
  contactId        Int       @map("contact_id")
  academicYear     String    @map("academic_year")
  formType         String    @map("form_type")
  status           FormInvitationStatus @default(pending)
  nominationSentAt DateTime? @map("nomination_sent_at")
  submittedAt      DateTime? @map("submitted_at")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  response FormResponse?

  @@unique([fellowshipId, formType, academicYear])
  @@index([status, academicYear])
  @@index([status, expiresAt])
  @@map("form_invitations")
}

model FormResponse {
  id           String   @id @default(cuid())
  invitationId String   @unique @map("invitation_id")
  data         Json
  createdAt    DateTime @default(now()) @map("created_at")

  invitation FormInvitation @relation(fields: [invitationId], references: [id])

  @@map("form_responses")
}
